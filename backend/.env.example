# Aurix Backend Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL Connection
DATABASE_URL=

# Grok (xAI) API - Primary LLM Provider
GROK_API_KEY=
GROK_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-beta

# Redis (for Celery task queue)
REDIS_URL=

# Tesseract OCR Path
TESSERACT_PATH=

# RAG - ChromaDB path
CHROMA_DB_PATH=

# Application
SECRET_KEY=
UPLOAD_FOLDER=
MAX_UPLOAD_SIZE=
LOG_LEVEL=
