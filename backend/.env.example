# Aurix Backend Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL Connection (Required for production)
# Example: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aurix

# Groq API - Primary LLM Provider (NOT Grok/xAI)
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=60
GROQ_MAX_RETRIES=3
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048

# Redis (Optional - for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# Tesseract OCR Path (Platform-specific)
# Windows: "C:/Program Files/Tesseract-OCR/tesseract.exe"
# Linux: /usr/bin/tesseract
# macOS: /usr/local/bin/tesseract
TESSERACT_PATH=/usr/bin/tesseract

# RAG - ChromaDB path
CHROMA_DB_PATH=./data/chromadb

# Application
SECRET_KEY=change-this-to-a-secure-random-string-in-production
UPLOAD_FOLDER=./uploads
MAX_UPLOAD_SIZE=20971520
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app
